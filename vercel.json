{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://queueni.onrender.com/api/$1" },
    { "source": "/api/v1/(.*)", "destination": "https://queueni.onrender.com/api/v1/$1" },
    { "source": "/ws/(.*)", "destination": "https://queueni.onrender.com/ws/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "unload=*" }
      ]
    }
  ]
}

